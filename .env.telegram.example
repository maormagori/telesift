# Telegram credentials, provisioned by the operator before starting telegram-service.
# Only telegram-service reads these; never commit real values.
#
# Under `docker compose`, copy this file to .env.telegram. Compose delivers it only to
# telegram-service. Keep these lines out of .env, which every container receives.
# For the native `npm run dev:*` path, put these lines in .env instead.
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_SESSION=
