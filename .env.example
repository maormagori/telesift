# Provisioned by the operator before starting telegram-service.
# Only telegram-service reads these; never commit real values.
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_SESSION=

# Internal-only HTTP contract (no public host port in a real deployment).
TELEGRAM_SERVICE_HOST=0.0.0.0
TELEGRAM_SERVICE_PORT=4001
TELEGRAM_SERVICE_LOCK_PATH=./data/telegram-service.lock

# "teleproto" (default) connects to real Telegram; "fake" uses synthetic
# in-memory fixtures for local development without credentials.
TELEGRAM_ADAPTER=teleproto

# "fake" (default) uses scripted local fixtures for development/tests without a real LLM.
# "openai-compatible" requires LLM_ENDPOINT_URL and LLM_MODEL, and calls a real local/self-hosted
# OpenAI-compatible chat-completions endpoint. LLM_API_KEY is operator-provisioned like the
# Telegram credentials above; leave it unset for endpoints that don't require one.
LLM_ADAPTER=fake
LLM_ENDPOINT_URL=
LLM_MODEL=
LLM_API_KEY=
# Local models can be slow; default is generous (2 minutes) to avoid spurious
# timeouts on larger self-hosted models. Only applies to LLM_ADAPTER=openai-compatible.
LLM_REQUEST_TIMEOUT_MS=120000

LOG_LEVEL=info

# Shared by every process; created by `npm run migrate` before other roles start.
DATABASE_PATH=./data/telesift.sqlite3

# Read by ingestion-worker and app to reach telegram-service's internal HTTP contract.
TELEGRAM_SERVICE_URL=http://127.0.0.1:4001

# The `app` process (authenticated UI/API). Single operator credential, matching the
# Telegram/LLM credential pattern above: provisioned via env, never created through the UI.
APP_HOST=0.0.0.0
APP_PORT=4000
APP_ADMIN_USERNAME=admin
# Generate with `npm run hash-admin-password`; a scrypt$<salt>$<hash> string, not a plaintext password.
APP_ADMIN_PASSWORD_HASH=
# Signs the session cookie; any long random string. Changing it logs out every session.
APP_SESSION_SECRET=
# Set to true only when `app` sits behind a reverse proxy terminating TLS in front of it.
APP_COOKIE_SECURE=false
