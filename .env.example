# Provisioned by the operator before starting telegram-service.
# Only telegram-service reads these; never commit real values.
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_SESSION=

# Internal-only HTTP contract (no public host port in a real deployment).
TELEGRAM_SERVICE_HOST=0.0.0.0
TELEGRAM_SERVICE_PORT=4001
TELEGRAM_SERVICE_LOCK_PATH=./data/telegram-service.lock

# "teleproto" (default) connects to real Telegram; "fake" uses synthetic
# in-memory fixtures for local development without credentials.
TELEGRAM_ADAPTER=teleproto

LOG_LEVEL=info
